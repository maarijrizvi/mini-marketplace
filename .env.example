# Copy to .env for local development. Values match docker-compose.yml.
DATABASE_URL=postgresql://mm:mm@localhost:5432/mini_marketplace

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=mm_sid
SESSION_TTL_HOURS=720
COOKIE_SECURE=false

# SQS via LocalStack
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/mm-events

# Mail (Mailpit catches everything; inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Mini Marketplace <no-reply@mini-marketplace.local>"

# Web
API_INTERNAL_URL=http://localhost:4000

# Development seed (npm run db:seed). Never used in production.
SEED_ADMIN_EMAIL=admin@mini-marketplace.local
SEED_ADMIN_PASSWORD=ChangeMe123
