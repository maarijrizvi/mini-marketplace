# Copy to .env and fill in. `docker compose` reads it automatically.
# Generate secrets with:  openssl rand -hex 32

# The address people type in the browser (the droplet's IP, no trailing slash).
PUBLIC_URL=http://203.0.113.10
HTTP_PORT=80

POSTGRES_USER=mm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mini_marketplace

JWT_SECRET=change-me-to-64-hex-characters-from-openssl-rand
PAYMENT_WEBHOOK_SECRET=change-me
LEOPARDS_WEBHOOK_SECRET=change-me
# No HTTPS on a bare IP, so cookies can't be marked Secure. Set true once a domain + TLS is in front.
COOKIE_SECURE=false

# Simulated payment gateway and courier (the only providers for now).
SANDBOX_ENABLED=true

# "user:password" for the API docs at /api/docs (empty = public).
DOCS_AUTH=docs:change-me

# Mailpit inbox at /mailpit/ (every email the app sends lands there).
MAILPIT_UI_AUTH=mail:change-me

SEED_ADMIN_EMAIL=admin@mini-marketplace.local
SEED_ADMIN_PASSWORD=change-me
# true = add demo shops, products and a customer (alex@example.com) on first start.
SEED_DEMO=true
SEED_DEMO_PASSWORD=Demo1234
