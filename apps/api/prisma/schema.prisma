// Mini Marketplace data model. One PostgreSQL schema, grouped by bounded context.
// Tables are snake_case; CHECK constraints that Prisma cannot express live in the migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity ─────────────────────────

enum Role {
  customer
  seller
  admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Stored lower-case.
  email           String     @unique
  /// E.164, e.g. +923001234567. One account per number.
  phone           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  role            Role       @default(customer)
  status          UserStatus @default(active)
  /// Null until the email code is confirmed; unverified users cannot sign in.
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz
  /// Admins only (TOTP).
  mfaSecret       String?    @map("mfa_secret")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions          Session[]
  authTokens        AuthToken[]
  addresses         Address[]
  sellerAccount     SellerAccount?  @relation("SellerAccountOwner")
  /// Seller accounts this customer registered (separate logins), used to show shop status.
  registeredSellers SellerAccount[] @relation("SellerAccountRegistrant")
  reviewedSellers   SellerAccount[] @relation("SellerAccountReviewer")
  cart              Cart?
  orders            Order[]

  @@map("users")
}

/// Server-side sessions. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenKind {
  verify_email
  reset_password
}

/// One-time codes and links. Only hashes are stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash")
  attempts  Int           @default(0)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  usedAt    DateTime?     @map("used_at") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  line1     String
  line2     String?
  city      String
  postcode  String?
  country   String   @default("PK")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

enum SellerStatus {
  pending
  approved
  suspended
  rejected
}

model SellerAccount {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  shopName           String       @map("shop_name")
  /// Lower-cased shop name; makes names unique regardless of case.
  shopNameKey        String       @unique @map("shop_name_key")
  category           String
  pickupAddress      String       @map("pickup_address")
  status             SellerStatus @default(pending)
  reviewReason       String?      @map("review_reason")
  reviewedById       String?      @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?    @map("reviewed_at") @db.Timestamptz
  registeredByUserId String?      @map("registered_by_user_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation("SellerAccountOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("SellerAccountReviewer", fields: [reviewedById], references: [id])
  registeredBy User?         @relation("SellerAccountRegistrant", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  products     Product[]
  sellerOrders SellerOrder[]

  @@index([status])
  @@map("seller_accounts")
}

// ───────────────────────── Catalogue ─────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  sku         String   @unique
  name        String
  description String   @default("")
  /// CHECK (price >= 0) in migration.
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller       SellerAccount       @relation(fields: [sellerId], references: [id])
  category     Category            @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  stock        StockItem?
  movements    InventoryMovement[]
  reservations StockReservation[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  /// S3 object key.
  objectKey String @map("object_key")
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

// ───────────────────────── Inventory ─────────────────────────

/// Row-locked (SELECT … FOR UPDATE) when checkout reserves stock.
/// CHECK (on_hand >= 0) and CHECK (reserved >= 0 AND reserved <= on_hand) in migration.
model StockItem {
  productId String   @id @map("product_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_items")
}

enum MovementReason {
  restock
  reserve
  commit
  release
  adjust
}

model InventoryMovement {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  delta     Int
  reason    MovementReason
  /// Order id or adjustment reference.
  refId     String?        @map("ref_id")
  actor     String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

enum ReservationStatus {
  held
  committed
  released
}

model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  orderId   String            @map("order_id") @db.Uuid
  productId String            @map("product_id") @db.Uuid
  quantity  Int
  status    ReservationStatus @default(held)
  expiresAt DateTime          @map("expires_at") @db.Timestamptz

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// ───────────────────────── Cart ─────────────────────────

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// CHECK (quantity > 0) in migration.
model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Int
  /// Price when added, so the cart can flag later price changes.
  priceAtAdd Decimal  @map("price_at_add") @db.Decimal(10, 2)
  isSelected Boolean  @default(false) @map("is_selected")
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ───────────────────────── Ordering ─────────────────────────

enum OrderStatus {
  pending_payment
  placed
  payment_failed
  cancelled
  completed
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  /// Human-friendly number, e.g. MM-10482.
  number         Int         @unique @default(autoincrement())
  customerId     String      @map("customer_id") @db.Uuid
  /// Same key from a repeated checkout returns the first order instead of creating another.
  idempotencyKey String      @unique @map("idempotency_key")
  status         OrderStatus @default(pending_payment)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(10, 2)
  shippingTotal  Decimal     @default(0) @map("shipping_total") @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  /// Copy of the shipping address at checkout.
  shipTo         Json        @map("ship_to")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  customer     User               @relation(fields: [customerId], references: [id])
  sellerOrders SellerOrder[]
  payments     Payment[]
  reservations StockReservation[]

  @@index([customerId, createdAt])
  @@map("orders")
}

enum SellerOrderStatus {
  new
  confirmed
  packed
  shipped
  delivered
  cancelled
}

/// One seller's part of an order, fulfilled and tracked on its own.
model SellerOrder {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  sellerId     String            @map("seller_id") @db.Uuid
  status       SellerOrderStatus @default(new)
  subtotal     Decimal           @db.Decimal(10, 2)
  shipping     Decimal           @default(0) @db.Decimal(10, 2)
  cancelReason String?           @map("cancel_reason")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  order    Order             @relation(fields: [orderId], references: [id])
  seller   SellerAccount     @relation(fields: [sellerId], references: [id])
  items    OrderItem[]
  shipment Shipment?
  events   FulfilmentEvent[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@map("seller_orders")
}

/// Product details and prices are copied, so later changes never alter past orders.
model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  sellerOrderId String  @map("seller_order_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  sku           String
  name          String
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity      Int
  discount      Decimal @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(10, 2)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ───────────────────────── Payments ─────────────────────────

enum PaymentStatus {
  pending
  succeeded
  failed
  unknown
  refunded
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  /// Sent to the provider, so a retried request never charges twice.
  idempotencyKey String        @unique @map("idempotency_key")
  providerRef    String?       @unique @map("provider_ref")
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(pending)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id              String        @id @default(uuid()) @db.Uuid
  paymentId       String        @map("payment_id") @db.Uuid
  providerEventId String        @unique @map("provider_event_id")
  status          PaymentStatus
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_events")
}

// ───────────────────────── Fulfilment ─────────────────────────

enum ShipmentStatus {
  label_created
  picked_up
  in_transit
  delivered
  exception
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  /// One parcel per seller order.
  sellerOrderId  String         @unique @map("seller_order_id") @db.Uuid
  carrier        String
  trackingNumber String?        @unique @map("tracking_number")
  labelRef       String?        @map("label_ref")
  status         ShipmentStatus @default(label_created)
  bookedAt       DateTime       @default(now()) @map("booked_at") @db.Timestamptz
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@map("shipments")
}

model FulfilmentEvent {
  id              String            @id @default(uuid()) @db.Uuid
  sellerOrderId   String            @map("seller_order_id") @db.Uuid
  fromStatus      SellerOrderStatus @map("from_status")
  toStatus        SellerOrderStatus @map("to_status")
  /// "seller:<id>" or "carrier-webhook".
  actor           String
  providerEventId String?           @unique @map("provider_event_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id])

  @@index([sellerOrderId, createdAt])
  @@map("fulfilment_events")
}

// ───────────────────────── Platform ─────────────────────────

/// Transactional outbox: written in the same transaction as the business change,
/// published to SQS by the worker. published_at NULL means not yet sent.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// Each handler records the messages it finished, so a redelivered message is skipped.
model ProcessedMessage {
  messageId   String   @map("message_id")
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([messageId, handler])
  @@map("processed_messages")
}

enum ActorType {
  user
  system
}

/// Append-only record of business and admin actions.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  /// User id, or the system process name.
  actorId    String    @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
